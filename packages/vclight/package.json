{
    "name": "vclight",
    "version": "3.4.3",
    "description": "A framework for serverless app",
    "author": "Bluemangoo",
    "license": "MIT",
    "main": "./dist/index",
    "types": "./dist/index.d.ts",
    "module": "./dist/index.mjs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bluemangoo/VCLight.git"
    },
    "files": [
        "LICENSE",
        "README.md",
        "dist/*"
    ],
    "keywords": [
        "typescript",
        "vercel"
    ],
    "scripts": {
        "build": "pnpm run build:esm && pnpm run build:cjs && gulp post-dts-build",
        "build:cjs": "tsc",
        "build:esm": "tsc -p tsconfig.esm.json && gulp post-esm-build"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260401.1",
        "@netlify/functions": "^5.1.5",
        "@netlify/serverless-functions-api": "^2.14.0",
        "@types/content-type": "^1.1.9",
        "@types/cookie": "^0.6.0",
        "@types/end-of-stream": "^1.4.4",
        "@types/etag": "^1.8.4",
        "@types/node": "^25.5.0",
        "@vercel/functions": "^3.4.3",
        "@vercel/node": "^5.6.23",
        "gulp": "^5.0.1",
        "typescript": "^6.0.2"
    },
    "dependencies": {
        "content-type": "^1.0.5",
        "cookie": "0.7.0",
        "end-of-stream": "^1.4.5",
        "etag": "^1.8.1"
    }
}
