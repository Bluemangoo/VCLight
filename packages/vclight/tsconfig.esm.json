{
    "compilerOptions": {
        "module": "esnext",
        "target": "ES2021",
        "lib": ["ES2024", "WebWorker"],
        "sourceMap": false,
        "declaration": true,
        "strict": true,
        "rootDir": "src",
        "outDir": "./dist",
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "bundler"
    },
    "exclude": ["./dist"]
}
